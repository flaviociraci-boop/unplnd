# dependencies
node_modules/
# Kept out of iCloud Drive: the real folders end in .nosync and node_modules / ios are
# symlinks to them (the project sits in an iCloud-synced Documents folder).
node_modules
node_modules.nosync/
node_modules.icloud-old/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# Claude Code local settings (per-user; can contain machine paths & secrets — never commit)
.claude/settings.local.json

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/ios.nosync
/android

# Founder-Originale der App-Icons (1254px) — nur Quellmaterial; die App nutzt die
# aufbereiteten 1024er (marble/lavender/mint/lime/holographic.png).
assets/images/app-icons/Icon_*.png
assets/images/app-icons/icon_1.png
